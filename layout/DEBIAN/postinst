#!/bin/sh
set -e
if [ "$1" = configure ]; then
    if [ ! -d /tmp/FTABHarvest ]; then
        mkdir -m 0777 /tmp/FTABHarvest
        chown mobile:mobile /tmp/FTABHarvest
    fi
    plist=/var/jb/Library/LaunchDaemons/com.parv.speaka.audio.plist
    chown root:wheel "$plist"
    chmod 644 "$plist"
    launchctl bootout system/com.parv.speaka.audio >/dev/null 2>&1 || true
    launchctl bootstrap system "$plist" || {
        echo 'Speaka: the audio helper could not start. If an older copy of this tweak is still installed under its previous package name, remove that package first (dpkg -l lists it), then reinstall Speaka.' >&2
        exit 1
    }
    # v9.9.3: Settings > Update notifications, checked every 15 minutes (SpeakaUpdateCheck). Optional: if it can't
    # start now it starts at the next boot, and it never fails the install. v9.9.5: it stays running (launchd's
    # StartInterval didn't repeat on iOS), and iOS keeps a mobile job in user/foreground, so both names are stopped.
    updates=/var/jb/Library/LaunchDaemons/com.parv.speaka.updatecheck.plist
    if [ -f "$updates" ]; then
        chown root:wheel "$updates" || true
        chmod 644 "$updates" || true
        launchctl bootout system/com.parv.speaka.updatecheck >/dev/null 2>&1 || true
        launchctl bootout user/foreground/com.parv.speaka.updatecheck >/dev/null 2>&1 || true
        launchctl bootstrap system "$updates" >/dev/null 2>&1 || echo 'Speaka: update checks start at the next reboot.' >&2
    fi
    # Load the newly installed tweak into bluetoothd now. Installing a package does not restart running daemons:
    # without this, bluetoothd keeps the previous build until its next restart while the Settings page (loaded
    # fresh) already shows the new features, so e.g. Start gets no answer. killall -9 is the same restart the
    # project has always used; launchd relaunches bluetoothd within seconds. It must never fail the install.
    echo 'Speaka: restarting bluetoothd to load the new version; Bluetooth devices reconnect in a few seconds.'
    killall -9 bluetoothd >/dev/null 2>&1 || launchctl kickstart -k system/com.apple.bluetoothd >/dev/null 2>&1 || true
fi
exit 0

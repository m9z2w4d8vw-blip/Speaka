# Theos build output
.theos/
packages/
obj/
*.deb

# The app's build output (XcodeGen + xcodebuild, see app/Makefile)
app/build/
app/Speaka.xcodeproj/
xcuserdata/

# Python caches from running the tests
__pycache__/
*.pyc

# Google libsbc is fetched at build time by tools/fetch_google_sbc.sh and is never committed
audiohelper/vendor_sbc/*
!audiohelper/vendor_sbc/README.md

# Logs copied off the phone
*.log

# OS clutter
.DS_Store
Thumbs.db

# Generated by the on-device AAC decode test's Makefile; regenerated on build, never committed.
tools/aac_decode_test/fixture_data.h
tools/aac_decode_test/aac_decode_test
